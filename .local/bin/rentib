#!/bin/sh

basename=$(basename "$0")
if [ "$basename" = rentib ]; then
    rentib="$basename " basename="$1"
    [ $# -gt 0 ] && shift || basename=help
fi

brightness() {
    printf %d "$1" >/dev/null 2>&1 || {
        echo "usage: rentib brightness [-|+]int" >&2
        exit 1
    }
    dev=/sys/class/backlight/amdgpu_bl1
    [ -e $dev ] || {
        echo "no backlight class found" >&2
        exit 1
    }
    read -r bri < $dev/brightness
    read -r max < $dev/max_brightness
    min=0
    perc="$((max / 100))"
    case "$1" in
        [-+]*) bri="$((bri + $1 * perc))" ;;
            *) bri="$((      $1 * perc))" ;;
    esac

    bri="$(( bri > max ? max : bri < min ? min : bri))"
    echo "$bri" | tee $dev/brightness
    bri="$(( bri * 100 / max ))"

    # TODO: xrdb was dropped, so somehing else must be used here
    # bar_color="$(xrdb -query | grep 'color1:' | awk '{print $2}')"
    notify-send \
        -t 1000 \
        -h string:x-dunst-stack-tag:notify_brightness \
        -h string:hlcolor:"$bar_color" \
        -h int:value:"$bri" \
        " $bri%"
}

volume() {
    dev=@DEFAULT_SINK@
    [ "$1" = '-m' ] && {
        dev=@DEFAULT_SOURCE@
        shift
    }
    case "$1" in
    mute) wpctl set-mute "$dev" toggle ;;
    [0-9] | [0-9][%] | [0-9][%][-+] | [0-9][0-9] | [0-9][0-9][%] | [0-9][0-9][%][-+])
        wpctl set-volume "$dev" "$1"
        ;;
    *)
        echo "usage: vol [-m] vol[%][-/+]|mute" >&2
        exit 1
        ;;
    esac

    case "$dev" in
    @DEFAULT_SINK@) pidof slstatus && kill -35 "$(pidof slstatus)" ;;
    @DEFAULT_SOURCE@) wpctl get-volume @DEFAULT_SOURCE@ | grep -q 'MUTED' && \
      echo 1 | tee /sys/class/leds/platform::micmute/brightness || \
      echo 0 | tee /sys/class/leds/platform::micmute/brightness ;;
    esac
}

pw_sink() {
    menu="mew"
    devices=$(pw-dump | jq -r '.[] | select(.info.props."media.class" == "Audio/Sink") | "\(.id)|\(.info.props."node.description")"')
    chosen=$(echo "$devices" | awk -F'|' '{print $2}' | $menu -i -p "Select audio device:")
    [ -z "$chosen" ] && exit 0
    chosen_id=$(echo "$devices" | grep "|$chosen$" | awk -F'|' '{print $1}')
    wpctl set-default $chosen_id
}

pw_source() {
    menu="mew"
    devices=$(pw-dump | jq -r '.[] | select(.info.props."media.class" == "Audio/Source") | "\(.id)|\(.info.props."node.description")"')
    chosen=$(echo "$devices" | awk -F'|' '{print $2}' | $menu -i -p "Select audio device:")
    [ -z "$chosen" ] && exit 0
    chosen_id=$(echo "$devices" | grep "|$chosen$" | awk -F'|' '{print $1}')
    wpctl set-default $chosen_id
}

case "$basename" in
brightness) brightness "$@" ;;
volume) volume "$@" ;;
sink) pw_sink "$@" ;;
source) pw_source "$@" ;;
*) echo "rentib: unknown command '$basename'" >&2; exit 1 ;;
esac
